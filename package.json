{
  "name": "broadcast-empire",
  "productName": "Broadcast Empire",
  "description": "Build a broadcasting company from one radio station in 1970 into a media empire.",
  "author": "Mike van der Meulen <support@broadcastempire.online>",
  "homepage": "https://broadcastempire.online",
  "private": true,
  "version": "0.20.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "simulate": "tsx scripts/simulate.ts",
    "voice-over": "tsx scripts/voice-over.ts",
    "town-maps": "tsx scripts/town-maps.ts",
    "office-sounds":"tsx scripts/office-sounds.ts",
    "record-voice": "tsx scripts/record-voice.ts",
    "review": "tsx scripts/review.ts",
    "website": "tsx scripts/website.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "desktop": "npm run build && electron .",
    "desktop:dev": "BROADCAST_EMPIRE_DEV_URL=http://localhost:5173/ electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "media.mvdm.broadcastempire",
    "productName": "Broadcast Empire",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    }
  }
}
